# Copie ce fichier en .env et remplis-le. Ne le partage JAMAIS, ne le mets jamais sur GitHub.

# Uniquement pour le mode réel. Clé Kraken avec droits : "Query funds", "Query/Create/Cancel orders".
# NE COCHE PAS "Withdraw funds" : même volée, la clé ne pourra pas vider ton compte.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Optionnel : alertes Telegram (créer un bot via @BotFather, chat id via @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
